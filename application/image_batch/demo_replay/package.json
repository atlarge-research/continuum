    "verify:browser": "node tools/verify-browser.ts",
    "format:check": "prettier --check src tools tests *.html *.json"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "typescript": "7.0.2"
  }
}
