{
    "base_image_rebuild_frequency": 10,
    "test_timeout_minutes": 60,
    "stop_on_failure": false,
    "success_detection": {
        "require_ssh_output": true,
        "require_exit_code_zero": true,
        "check_log_files": false,
        "infra_only_override": {
            "require_ssh_output": false,
            "require_exit_code_zero": true
        }
    },
    "test_suites": {
        "smoke": {
            "directories": [
                "configuration/tests/"
            ],
            "use_cache": true,
            "rebuild_base_images": false
        },
        "full": {
            "directories": [
                "configuration/"
            ],
            "use_cache": false,
            "rebuild_base_images": true
        },
        "network_validation": {
            "directories": [
                "configuration/network_validation/"
            ],
            "use_cache": true,
            "rebuild_base_images": false
        }
    },
    "exclude_patterns": [
        "template.cfg"
    ]
}