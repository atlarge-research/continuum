        },
        "qemu_k8s_image_parity": {
            "directories": [
                "configs/experiments/parity/qemu_k8s_image/"
            ],
            "use_cache": true,
            "rebuild_base_images": false,
            "stop_on_failure": true,
            "success_detection": {
                "require_network_validation_results": true,
                "required_stdout_markers": [
                    "Benchmark has been finished, prepare results",
                    "ENDPOINT OUTPUT",
                    "latency_avg (ms)"
                ],
                "required_stdout_metric_tables": [
                    {
                        "label": "ENDPOINT OUTPUT",
                        "columns": [
                            "latency_avg (ms)"
                        ],
                        "min_rows": 1
                    }
                ],
                "required_benchmark_metric_artifacts": [
                    {
                        "label": "ENDPOINT OUTPUT",
                        "columns": [
                            "latency_avg (ms)"
                        ],
                        "numeric_columns": [
                            "latency_avg (ms)"
                        ],
                        "min_rows": 1,
                        "stat_assertions": [
                            {
                                "column": "latency_avg (ms)",
                                "min": 0.0,
                                "max": 600000.0,
                                "mean_min": 0.0,
                                "mean_max": 600000.0
                            }
                        ]
                    }
                ]
            },
            "prerequisites": {
                "summary": "Requires a local QEMU/libvirt host with SSH access, tc/netperf support, and a primed local registry cache for Kubernetes image-classification application images",
                "commands": [
                    "virsh",
                    "ssh",
                    "tc",
                    "setfacl",
                    "curl",
                    "qemu-img",
                    "cloud-localds",
                    "ansible-playbook"
                ],
                "checks": [
                    {
                        "name": "Local registry cache",
                        "command": [
                            "python3",
                            "scripts/test/prime_local_registry_cache.py",
                            "--suite",
                            "qemu_k8s_image_parity",
                            "--check-only"
                        ]
                    }
                ]
            }
        },
